    a = ALIAS_AUTOR.get(a, a)
    return a == nm.upper()

VAGO = re.compile(r"\b(vou verificar|vou analisar|vou ver|vou olhar|vou checar|assim que poss[ií]vel|qualquer coisa (te )?aviso|mais tarde te (falo|aviso))\b", re.I)
